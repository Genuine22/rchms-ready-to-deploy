# ============================================================
# RCHMS Configuration (EXAMPLE — copy this file to ".env" and
# fill in your real values there. NEVER commit the real .env
# file to GitHub or share it — it holds your DB password and
# secret key.)
# ============================================================

# MySQL connection details
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password-here
DB_NAME=rchms_db

# Random secret key used to keep login sessions secure.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Network settings
HOST=0.0.0.0
PORT=5000

# Debug mode - keep false in production/for the lecturer's review
DEBUG_MODE=false
